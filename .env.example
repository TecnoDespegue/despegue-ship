# ----------------------------------------------------------------------------
# Enterprise Dev System — Landing Page (agents-landing)
# Environment variables
# ----------------------------------------------------------------------------
# Copy this file to `.env.local` for local dev, or to `.env.production` for
# production overrides. Vercel reads these from the project's Environment
# Variables UI. NEVER commit a real `.env.local` — only this template.
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Required
# ----------------------------------------------------------------------------

# Canonical absolute URL of the deployed site. Used by Metadata, Open Graph,
# Twitter Card, JSON-LD `Organization.url` / `logo`, and the Vercel
# build-time `metadataBase`. Include the scheme, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://despegueship.dev

# ----------------------------------------------------------------------------
# Optional — Analytics
# ----------------------------------------------------------------------------

# Server-side, IP-anonymized, aggregate Vercel Web Analytics. No PII, no
# third-party cookies. The analytics script reads this at build time.
# Speeds are *unaffected* — the script loads via Next's `next/script` with
# strategy="afterInteractive".
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# ----------------------------------------------------------------------------
# Optional — Release-notes email capture (CTA section)
# ----------------------------------------------------------------------------

# Where the CTA's email form POSTs. v1 is a stub; production should point
# this at a server action or a transactional-email service like Resend.
# Leaving blank hides the form gracefully and shows the GitHub CTA instead.
NEWSLETTER_WEBHOOK_URL=

# ----------------------------------------------------------------------------
# Optional — Repo metadata (overrides the lib/site.ts defaults)
# ----------------------------------------------------------------------------

# Display name for the framework (used in <title>, JSON-LD, OG).
NEXT_PUBLIC_SITE_NAME=DespegueShip

# Short tag rendered after the page title in the tab title and meta tags.
NEXT_PUBLIC_SITE_SHORT_NAME=Enterprise Dev System

# Twitter handle used in twitter:creator.
NEXT_PUBLIC_TWITTER_HANDLE=@tecnodespegue

# ----------------------------------------------------------------------------
# Build-time only — never exposed to the browser
# ----------------------------------------------------------------------------

# Set to "1" to disable Next.js build-time telemetry (default in CI already).
NEXT_TELEMETRY_DISABLED=0
