{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "buildCommand": "next build",
  "framework": "nextjs",
  "regions": ["iad1", "gru1"],
  "trailingSlash": false,
  "cleanUrls": true,
  "github": {
    "silent": false,
    "autoAlias": true
  },

  "headers": [
    {
      "source": "/(.*)\\.(js|css|woff2?|svg|png|jpg|jpeg|gif|webp|avif)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "all, max-image-preview:large"
        }
      ]
    }
  ]
}
